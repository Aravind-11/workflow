# =============================================================================
# WMS — copy to `.env.local` for local dev. On Vercel, set these in Project Settings → Environment Variables.
# =============================================================================

# MongoDB Atlas connection string (required for Prisma)
#
# Get yours from: MongoDB Atlas → Database → Connect → Drivers → Connection string
# Make sure to include the database name (e.g. /wms) in the path.
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/wms?retryWrites=true&w=majority"

# Supabase Auth (required for login — API URL + anon key)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Optional: Supabase service role — server-only; never expose to the client.
# SUPABASE_SERVICE_ROLE_KEY=""

# Required by Next.js 16 server actions. Generate once with:
#   openssl rand -base64 32
# Bumping it invalidates in-flight server-action ids, so prefer to keep stable.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# AI assistant (chat panel + workflow auto-creator)
# - If OPENAI_API_KEY is set, the app uses OpenAI directly.
# - Otherwise it talks to an OpenAI-compatible endpoint (Ollama).
#   For local dev: leave OLLAMA_BASE_URL blank and run `ollama serve` locally,
#   or point it at the prod Ollama EC2 (private IP, only reachable from
#   whitelisted IPs).
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="llama3.1:8b-instruct-q4_K_M"
OLLAMA_TOOLS="false"
